# Never commit the real .env file.
#
# Every value here is the default compiled into main.py. Setting a variable only
# makes sense when you want to depart from that default, so this file documents
# the knob and its shipped value rather than overriding anything.

# --- Request admission ------------------------------------------------------
# Must not exceed Nginx's client_max_body_size, which is 4m. Raised to 4,000,000
# together with it, so a boundary file at the NRT's size can be posted at all.
MAX_GEOJSON_BYTES=4000000
MAX_AOI_VERTICES=10000

# Area budgets, in square kilometres of *bounding box* rather than polygon area,
# so an irregular outline is penalised by its own rectangle. Derived from
# measurement; see README "Measured limits" and the table in main.py.
MAX_SYNC_BBOX_KM2=100
MAX_LANDCOVER_BBOX_KM2=1000

# Bounded Planetary Computer search.
MAX_PC_SCENES=4
MAX_SOURCE_TILES=64

# --- Concurrency ------------------------------------------------------------
# Bound by read latency against Planetary Computer, not by memory or CPU: eight
# concurrent analyses peak at 301 MB RSS and 14% of one core. NDVI gets a
# tighter guard because it is the only path whose latency degrades.
MAX_CONCURRENT_ANALYSES=8
MAX_CONCURRENT_NDVI=3
ANALYSIS_ACQUIRE_SECONDS=2
NDVI_ACQUIRE_SECONDS=20
ANALYSIS_DRAIN_SECONDS=20

# --- Rainfall series cache --------------------------------------------------
# The portfolio is a build artefact, fetched before serving with
#   python -m tools.sync_rainfall_cache --pull
# All three remote variables are optional: unset, the cache is local only and
# every remote call is a no-op. Set RAINFALL_CACHE_DIR to a path writable inside
# the container.
RAINFALL_CACHE_DIR=.rainfall-cache
RAINFALL_CACHE_S3_URI=
RAINFALL_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
RAINFALL_S3_REGION=nyc3

# Spaces uses the standard AWS credential names. Leave unset when the remote is
# not configured.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Web --------------------------------------------------------------------
# Comma-separated browser origins. The production Nginx route uses same-origin
# /api, so this only matters for development or a separate frontend.
CORS_ORIGINS=https://209.38.197.161,http://localhost:3000
PORT=8001
PYTHONUNBUFFERED=1
